APOLLO_ACCOUNT_RESOURCE_NAME=apollo-account-staging
# Set in Coolify to the exact reviewed 40-hex source commit before rendering.
# Intentionally empty so a copied example cannot deploy without provenance.
APOLLO_ACCOUNT_SOURCE_COMMIT=
# Root-owned host directory. Keep the directory mode 0700. The five one-line
# files named by the Compose secrets must be root:root mode 0444 so the
# explicitly granted non-root Auth (uid 1000) and Envoy (uid 101) mounts work;
# Docker Compose cannot remap uid/gid/mode for file-backed secrets.
APOLLO_ACCOUNT_SECRET_DIRECTORY=/var/lib/apollo-account-staging/secrets
APOLLO_ACCOUNT_GATEWAY_PORT=18300
APOLLO_ACCOUNT_MAIL_UI_PORT=18301
APOLLO_ACCOUNT_API_EXTERNAL_URL=http://127.0.0.1:18300/auth/v1
# Redirect-only placeholder for isolated staging; nothing listens on 18302.
APOLLO_ACCOUNT_SITE_URL=http://127.0.0.1:18302

APOLLO_ACCOUNT_POSTGRES_IMAGE=supabase/postgres:17.6.1.136@sha256:f371b5f3f2ac0a05703f33d6e6134515fb2498cab708fb948a0aeb7481467c00
APOLLO_ACCOUNT_AUTH_IMAGE=supabase/gotrue:v2.189.0@sha256:385184459f57569c54c25209f51f3b2be99ddd7c4ce9e3555b5d3eea8447b7cf
APOLLO_ACCOUNT_GATEWAY_IMAGE=envoyproxy/envoy:v1.39.0@sha256:d59f7f5fa10cff6d5892b6c5e7df5c9297ddfb2c3683e33fbfb82da24de4fa66
APOLLO_ACCOUNT_MAIL_IMAGE=axllent/mailpit:v1.31.0@sha256:c96991d9bef73594c246d89ca81411d4e916f03e76a7d2d72fa2ab5dd3c9ce24
